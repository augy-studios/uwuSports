<?xml version="1.0" encoding="utf-8"?>
<!-- Windows tile metadata. Read only by legacy pinned-site tiles, and by
     nothing else in the app. Points at the icons that exist rather than the
     separate tile.png and tile-wide.png this file originally referenced,
     which were never in the repo. -->
<browserconfig>
    <msapplication>
        <tile>
            <square150x150logo src="/USC-192.png"/>
            <square310x310logo src="/USC-512.png"/>
            <TileColor>#ccffcc</TileColor>
        </tile>
    </msapplication>
</browserconfig>
