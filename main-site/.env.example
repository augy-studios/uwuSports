# uwuSports environment variables
#
# Copy to .env.local for local development, and set the same keys in the
# Vercel dashboard under Settings, Environment Variables. Never commit the
# filled-in copy: .env.local and .env are both in .gitignore.
#
# Every key here is optional. The app boots and serves with none of them
# set, because each adapter degrades on its own:
#   - Missing Supabase means the API cache falls back to per-instance
#     in-memory caching and favourites stay on the device.
#   - Missing balldontlie key means the NBA section reports the key as
#     unconfigured rather than showing fabricated games.
#   - Missing football-data key does the same for the football section.
# Only Jolpica-F1, TheSportsDB and ESPN need no credentials at all.


# ---------------------------------------------------------------------------
# Supabase: shared cache and signed-in favourites
# ---------------------------------------------------------------------------
# The single shared uwuapps Supabase project. Vercel functions do not share
# in-memory state between invocations, so the upstream response cache lives
# in Postgres instead. See api/README.md for the table SQL.
#
# Server side only. The service role key bypasses row level security, so it
# must never be exposed to the browser and must never be prefixed in a way
# that a client bundle would pick up.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The anon key, only if a future client-side read needs it. Not used by the
# current code: every Supabase call goes through main-site/api/.
SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# balldontlie: NBA
# ---------------------------------------------------------------------------
# Free key from https://app.balldontlie.io, no card required.
# Free tier is roughly 60 requests per minute. Live game data refreshes
# about every 10 minutes upstream, which is why the NBA section labels its
# scores as delayed rather than live.

BALLDONTLIE_API_KEY=


# ---------------------------------------------------------------------------
# football-data.org: football and soccer
# ---------------------------------------------------------------------------
# Free key from https://www.football-data.org/client/register, no card.
# Limit 10 requests per minute, 12 major competitions. Scores are delayed
# on the free tier and are labelled as such in the UI.

FOOTBALL_DATA_API_KEY=


# ---------------------------------------------------------------------------
# TheSportsDB: badges, artwork, multi-sport browse
# ---------------------------------------------------------------------------
# The free public test key is "3" and needs no signup, which is the default
# the code uses when this is unset. Set it only if you have a Patreon key,
# which raises the 30 requests per minute limit and unlocks livescores.
# Treat the free tier as a schedules, metadata and artwork source only.

THESPORTSDB_API_KEY=3


# ---------------------------------------------------------------------------
# API-Sports.io: secondary, 12 sports on one schema
# ---------------------------------------------------------------------------
# Free key from https://dashboard.api-sports.io, no card.
# 100 requests per DAY per sport API. That is tight enough that this is used
# only for endpoints the primary sources cannot serve, with long cache TTLs.
# One key works across every sport host.

API_SPORTS_KEY=


# ---------------------------------------------------------------------------
# Jolpica-F1: Formula 1
# ---------------------------------------------------------------------------
# No key, no signup, Apache 2.0. Listed here only so the base URL can be
# pointed at a self-hosted instance if the public one is rate limited.
# Unauthenticated limit is 200 requests per hour.

JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1


# ---------------------------------------------------------------------------
# ESPN: unofficial live-ish scores, enhancement layer only
# ---------------------------------------------------------------------------
# Undocumented public endpoints, no key. Not a supported API and it can
# change or break without notice, so it never serves a section on its own
# and always falls back to the primary source.
#
# Set to "0" to switch the enhancement layer off entirely, for instance if
# the endpoints start returning nonsense. Defaults to on.

ESPN_ENABLED=1


# ---------------------------------------------------------------------------
# Cache tuning, all optional
# ---------------------------------------------------------------------------
# Seconds. These are the defaults the code uses when unset; override only
# if an upstream starts rate limiting. Never poll faster than the slowest
# source allows.

CACHE_TTL_LIVE=45
CACHE_TTL_SCHEDULE=300
CACHE_TTL_STANDINGS=1800
CACHE_TTL_METADATA=86400
